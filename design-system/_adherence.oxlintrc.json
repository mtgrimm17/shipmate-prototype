{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/progress/**",
              "components/submission/**",
              "components/surfaces/**",
              "ui_kits/app/**",
              "ui_kits/marketing/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|JetBrains Mono|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Inter, JetBrains Mono, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActionCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|impact|impactLabel|resolved|page|pages|onPrev|onNext|children|key|ref|className|style|children)$/]",
        "message": "<ActionCard> doesn't accept that prop. Declared props: title, impact, impactLabel, resolved, page, pages, onPrev, onNext, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActionCard'] > JSXAttribute[name.name='impact'] > Literal[value!=/^(?:high|medium|notice)$/]",
        "message": "<ActionCard> impact must be one of 'high' | 'medium' | 'notice'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AlertBox'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|children|key|ref|className|style|children)$/]",
        "message": "<AlertBox> doesn't accept that prop. Declared props: title, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Button> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:ready|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: ready, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChipButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:selected|block|children|key|ref|className|style|children)$/]",
        "message": "<ChipButton> doesn't accept that prop. Declared props: selected, block, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='CodeBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|code|maxHeight|key|ref|className|style|children)$/]",
        "message": "<CodeBlock> doesn't accept that prop. Declared props: label, code, maxHeight."
      },
      {
        "selector": "JSXOpeningElement[name.name='CtaButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|arrow|key|ref|className|style|children)$/]",
        "message": "<CtaButton> doesn't accept that prop. Declared props: children, arrow."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dropzone'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|compact|required|key|ref|className|style|children)$/]",
        "message": "<Dropzone> doesn't accept that prop. Declared props: label, hint, compact, required."
      },
      {
        "selector": "JSXOpeningElement[name.name='FormLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:required|hint|children|key|ref|className|style|children)$/]",
        "message": "<FormLabel> doesn't accept that prop. Declared props: required, hint, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|active|children|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: label, active, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:as|required|children|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: as, required, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:input|textarea|select)$/]",
        "message": "<Input> as must be one of 'input' | 'textarea' | 'select'."
      },
      {
        "selector": "JSXOpeningElement[name.name='InsightPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|onBack|children|key|ref|className|style|children)$/]",
        "message": "<InsightPanel> doesn't accept that prop. Declared props: title, onBack, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Menu'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|children|key|ref|className|style|children)$/]",
        "message": "<Menu> doesn't accept that prop. Declared props: width, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|children|key|ref|className|style|children)$/]",
        "message": "<Modal> doesn't accept that prop. Declared props: width, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='NoticeBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:onDismiss|dismissLabel|children|key|ref|className|style|children)$/]",
        "message": "<NoticeBanner> doesn't accept that prop. Declared props: onDismiss, dismissLabel, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='PartnerCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|description|href|logo|key|ref|className|style|children)$/]",
        "message": "<PartnerCard> doesn't accept that prop. Declared props: name, description, href, logo."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pill'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|icon|children|key|ref|className|style|children)$/]",
        "message": "<Pill> doesn't accept that prop. Declared props: tone, icon, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pill'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|ready|processing)$/]",
        "message": "<Pill> tone must be one of 'neutral' | 'ready' | 'processing'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlatformIcon'] > JSXAttribute > JSXIdentifier[name!=/^(?:platform|size|well|base|key|ref|className|style|children)$/]",
        "message": "<PlatformIcon> doesn't accept that prop. Declared props: platform, size, well, base."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlatformIcon'] > JSXAttribute[name.name='platform'] > Literal[value!=/^(?:ios|android|steam|psn|xbox|nintendo)$/]",
        "message": "<PlatformIcon> platform must be one of 'ios' | 'android' | 'steam' | 'psn' | 'xbox' | 'nintendo'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|key|ref|className|style|children)$/]",
        "message": "<ProgressBar> doesn't accept that prop. Declared props: value."
      },
      {
        "selector": "JSXOpeningElement[name.name='Shimmer'] > JSXAttribute > JSXIdentifier[name!=/^(?:short|height|key|ref|className|style|children)$/]",
        "message": "<Shimmer> doesn't accept that prop. Declared props: short, height."
      },
      {
        "selector": "JSXOpeningElement[name.name='Shippy'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|glow|float|base|key|ref|className|style|children)$/]",
        "message": "<Shippy> doesn't accept that prop. Declared props: width, glow, float, base."
      },
      {
        "selector": "JSXOpeningElement[name.name='Spinner'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|tone|key|ref|className|style|children)$/]",
        "message": "<Spinner> doesn't accept that prop. Declared props: size, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Spinner'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:selection|processing)$/]",
        "message": "<Spinner> tone must be one of 'selection' | 'processing'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|key|ref|className|style|children)$/]",
        "message": "<StatusPill> doesn't accept that prop. Declared props: tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:prod|pre)$/]",
        "message": "<StatusPill> tone must be one of 'prod' | 'pre'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepDots'] > JSXAttribute > JSXIdentifier[name!=/^(?:count|active|key|ref|className|style|children)$/]",
        "message": "<StepDots> doesn't accept that prop. Declared props: count, active."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|name|done|state|risk|right|key|ref|className|style|children)$/]",
        "message": "<StepRow> doesn't accept that prop. Declared props: index, name, done, state, risk, right."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepRow'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:default|risk-warn|risk-high)$/]",
        "message": "<StepRow> state must be one of 'default' | 'risk-warn' | 'risk-high'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepRow'] > JSXAttribute[name.name='risk'] > Literal[value!=/^(?:high|medium|low|none)$/]",
        "message": "<StepRow> risk must be one of 'high' | 'medium' | 'low' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TaskRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|done|key|ref|className|style|children)$/]",
        "message": "<TaskRow> doesn't accept that prop. Declared props: label, done."
      },
      {
        "selector": "JSXOpeningElement[name.name='TipBox'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|wash|title|children|key|ref|className|style|children)$/]",
        "message": "<TipBox> doesn't accept that prop. Declared props: icon, wash, title, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Toggle> doesn't accept that prop. Declared props: checked, onChange, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TooltipIcon'] > JSXAttribute > JSXIdentifier[name!=/^(?:warned|glyph|title|key|ref|className|style|children)$/]",
        "message": "<TooltipIcon> doesn't accept that prop. Declared props: warned, glyph, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:height|base|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: height, base."
      },
      {
        "selector": "JSXOpeningElement[name.name='YesNoButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:selected|inferred|children|key|ref|className|style|children)$/]",
        "message": "<YesNoButton> doesn't accept that prop. Declared props: selected, inferred, children."
      }
    ]
  },
